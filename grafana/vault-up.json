{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Shared Prometheus for the on-premises clusters",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "id": null,
  "uid": "vault-up-canary",
  "title": "Vault canary",
  "description": "Vault secret-injection canary for dev-fss and prod-fss. Missing metrics are not a successful check; cluster discovery uses on-premises kube-state-metrics scrape targets.",
  "tags": ["nais", "vault", "canary"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
        "query": {
          "query": "label_values(up{job=\"kube-state-metrics\",k8s_cluster_name=~\"dev-fss|prod-fss\"}, k8s_cluster_name)",
          "refId": "ClusterVariable"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "dev-fss|prod-fss",
        "current": {"selected": true, "text": "All", "value": "$__all"},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Canary observed",
      "description": "Observed means the CronJob is present in kube-state-metrics, not that a run succeeded. No metrics means the CronJob is missing or its metrics are unavailable. Clusters remain visible while their kube-state-metrics scrape target exists.",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "(max by (k8s_cluster_name) (kube_cronjob_created{namespace=\"nais-system\",cronjob=\"vault-up\",k8s_cluster_name=~\"${cluster:regex}\"}) > bool 0) or on (k8s_cluster_name) (0 * max by (k8s_cluster_name) (up{job=\"kube-state-metrics\",k8s_cluster_name=~\"${cluster:regex}\"}))",
          "instant": true,
          "range": false,
          "legendFormat": "{{k8s_cluster_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No metrics",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "Not observed", "color": "red", "index": 0},
                "1": {"text": "Observed", "color": "green", "index": 1}
              }
            }
          ],
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Time since last success",
      "description": "Normally below two minutes. Red when older than five minutes; the alert fires after that persists for one minute. No success data means the canary has never succeeded or its metrics are missing.",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 4, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - max by (k8s_cluster_name) (kube_cronjob_status_last_successful_time{namespace=\"nais-system\",cronjob=\"vault-up\",k8s_cluster_name=~\"${cluster:regex}\"})) or on (k8s_cluster_name) (0 * max by (k8s_cluster_name) (up{job=\"kube-state-metrics\",k8s_cluster_name=~\"${cluster:regex}\"}) - 1)",
          "instant": true,
          "range": false,
          "legendFormat": "{{k8s_cluster_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "min": 0,
          "noValue": "No success data",
          "mappings": [
            {"type": "value", "options": {"-1": {"text": "No success data", "color": "red", "index": 0}}}
          ],
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "red", "value": 300}]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Success freshness history",
      "description": "Each successful run resets the age. A sustained rise indicates no new successful runs; gaps mean no last-success metric is available.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (k8s_cluster_name) (kube_cronjob_status_last_successful_time{namespace=\"nais-system\",cronjob=\"vault-up\",k8s_cluster_name=~\"${cluster:regex}\"})",
          "instant": false,
          "range": true,
          "legendFormat": "{{k8s_cluster_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "red", "value": 300}]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": {"mode": "line"}
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "id": 4,
      "title": "Active canary alerts",
      "description": "Pending and firing Prometheus canary alerts. An empty table is expected when no alerts are active; use the panels above to verify that metrics are present.",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 12},
      "targets": [
        {
          "refId": "A",
          "expr": "max by (k8s_cluster_name, alertname, alertstate) (ALERTS{namespace=\"nais-system\",k8s_cluster_name=~\"${cluster:regex}\",alertname=~\"vault-up-(no-recent-success|missing)\",alertstate=~\"pending|firing\"})",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {"Time": true, "Value": true},
            "indexByName": {"k8s_cluster_name": 0, "alertname": 1, "alertstate": 2},
            "renameByName": {"k8s_cluster_name": "Cluster", "alertname": "Alert", "alertstate": "State"}
          }
        }
      ],
      "fieldConfig": {"defaults": {}, "overrides": []},
      "options": {"showHeader": true}
    }
  ]
}
